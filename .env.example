# ── LLM provider ──
# Options: 'anthropic' | 'deepseek' | 'bazaarlink' | 'disabled'
LLM_PROVIDER=disabled

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# BazaarLink (OpenAI-compatible)
BAZAARLINK_API_KEY=sk-bl-...
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL=deepseek-v4-flash

# Qwen (Alibaba, OpenAI-compatible)
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Auth ──
SESSION_TTL_DAYS=30
SEED_INSTRUCTOR_EMAIL=sheban@codeteach.local
SEED_INSTRUCTOR_PASSWORD=change-me-in-env
SEED_INSTRUCTOR_NAME=Sheban

# ── Server ──
ADMIN_API_KEY=change-me
ALERT_WEBHOOK_URL=
PORT=3001
NODE_ENV=development
DEV_BYPASS_AUTH=false

# ── Admin role ──
# By default, anyone who signs up as an Instructor is automatically
# granted admin powers (can mint invite codes). Set the flag below to
# true to disable that: new instructors become regular instructors
# who cannot mint invite codes. Promote them via:
#
#   node scripts/make-admin.mjs <email>
#
# DISABLE_OPEN_ADMIN=true

# ── Email (nudges) ──
# Optional. If these are not set, emails are logged to the console
# instead of being sent. Configure these for real deliveries.
#
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="CodeTeach <noreply@yourdomain.com>"
#
# APP_BASE_URL=https://codeteach.yourdomain.com
