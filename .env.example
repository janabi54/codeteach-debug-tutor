# ── LLM provider ──
# Options: 'anthropic' | 'deepseek' | 'bazaarlink' | 'disabled'
LLM_PROVIDER=disabled

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# BazaarLink (OpenAI-compatible)
BAZAARLINK_API_KEY=sk-bl-...
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL=deepseek-v4-flash

# Qwen (Alibaba, OpenAI-compatible)
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Auth ──
SESSION_TTL_DAYS=30
SEED_INSTRUCTOR_EMAIL=sheban@codeteach.local
SEED_INSTRUCTOR_PASSWORD=change-me-in-env
SEED_INSTRUCTOR_NAME=Sheban

# ── Server ──
ADMIN_API_KEY=change-me
ALERT_WEBHOOK_URL=
PORT=3001
NODE_ENV=development
DEV_BYPASS_AUTH=false
